rules_version = '2';

// Reglas de seguridad de Family App.
// Cada teléfono inicia sesión de forma anónima; solo los teléfonos aprobados
// de un hogar pueden leer y escribir los datos de ese hogar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function homeData(homeId) {
      return get(/databases/$(database)/documents/homes/$(homeId)).data;
    }

    function isMember(homeId) {
      return signedIn() && request.auth.uid in homeData(homeId).memberUids;
    }

    function isAdmin(homeId) {
      return signedIn() && request.auth.uid in homeData(homeId).adminUids;
    }

    // El perfil (miembro) que usa este teléfono.
    function isMe(homeId, memberId) {
      return signedIn()
        && get(/databases/$(database)/documents/homes/$(homeId)/members/$(memberId)).data.uid == request.auth.uid;
    }

    // Invitaciones de un solo uso. Se leen por código (no se pueden listar).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isAdmin(request.resource.data.homeId)
        && request.resource.data.usedBy == null;
      // Quien escanea solo puede marcarla como usada por sí mismo, una vez.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if isAdmin(resource.data.homeId);
    }

    // ------------------------------------------------- familias amigas
    // Una familia genera un código (un adulto administrador) y la otra lo
    // acepta (otro adulto administrador): doble aprobación. Solo se
    // comparten apodos y avatares de quienes cada familia elige.
    match /friendInvites/{code} {
      allow get: if signedIn();
      allow create: if isAdmin(request.resource.data.homeId)
        && request.resource.data.usedBy == null;
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if isAdmin(resource.data.homeId);
    }

    match /friendships/{friendshipId} {
      allow read: if isMember(resource.data.homeA);
      allow read: if isMember(resource.data.homeB);
      allow create: if isAdmin(request.resource.data.homeB)
        && request.resource.data.status == 'active'
        && getAfter(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteCode)).data.homeId == request.resource.data.homeA
        && getAfter(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid;
      // Cada familia cambia solo su lista; cualquiera de las dos puede terminarla.
      allow update: if (isAdmin(resource.data.homeA)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kidsA', 'status']))
        || (isAdmin(resource.data.homeB)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kidsB', 'status']));
    }

    // Partidas entre dos familias amigas (con la amistad activa).
    match /sharedGames/{gameId} {
      function friendsOk(data) {
        return get(/databases/$(database)/documents/friendships/$(data.friendshipId)).data.status == 'active';
      }
      allow read: if isMember(resource.data.homeA);
      allow read: if isMember(resource.data.homeB);
      allow create, update: if (isMember(request.resource.data.homeA) || isMember(request.resource.data.homeB))
        && friendsOk(request.resource.data);
      allow delete: if isMember(resource.data.homeA) || isMember(resource.data.homeB);
    }

    // Paquetes de palabras: los lee cualquier teléfono; se cargan desde la
    // consola o con tools/vocabulario.
    match /vocab/{packId} {
      allow read: if signedIn();
    }

    match /homes/{homeId} {
      // Quien crea el hogar queda como único administrador y miembro.
      allow create: if signedIn()
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.memberUids == [request.auth.uid];
      allow read: if isMember(homeId);
      // "plus" (Family App Plus) no se cambia desde la app: solo desde la
      // consola de Firebase (o, más adelante, el servidor de cobros).
      allow update: if isAdmin(homeId)
        && !('plus' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAdmin(homeId);

      match /members/{memberId} {
        // Un teléfono pendiente de aprobación puede ver su propio perfil.
        allow read: if isMember(homeId)
          || (signedIn() && resource.data.uid == request.auth.uid);
        // Los adultos agregan miembros; quien escanea una invitación válida
        // se agrega como pendiente (en el mismo lote en que la marca usada).
        allow create: if isAdmin(homeId)
          || (signedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.pending == true
            && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.homeId == homeId
            && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid);
        // Teléfono nuevo de un perfil existente: con una invitación para ese
        // perfil, solo puede ponerse como su teléfono y quedar pendiente.
        // Los adultos administradores cambian cualquier perfil. Cada teléfono
        // solo cambia el suyo: avatar, colores, cuarto y puntos (los puntos
        // suben de a poco: tareas, quiz o reto; bajan al canjear).
        allow update: if isAdmin(homeId)
          || (isMember(homeId)
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nickname', 'avatar', 'accent', 'look', 'unlocked', 'balance', 'room', 'progress'])
            && (!('balance' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.balance - resource.data.balance <= 150))
          || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'pending', 'relink', 'inviteCode'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.pending == true
            && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.homeId == homeId
            && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.memberId == memberId
            && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid);
        allow delete: if isAdmin(homeId);
      }

      // Día de cada miembro: lo escribe su teléfono o un adulto administrador.
      match /days/{dayId} {
        allow read: if isMember(homeId);
        allow write: if isAdmin(homeId)
          || (isMember(homeId)
            && dayId.matches(request.resource.data.memberId + '_.*')
            && isMe(homeId, request.resource.data.memberId));
      }

      // Canjes: cada uno pide los suyos; solo los adultos aprueban o rechazan.
      match /redemptions/{redemptionId} {
        allow read: if isMember(homeId);
        allow create: if isAdmin(homeId)
          || (isMember(homeId)
            && request.resource.data.status == 'pending'
            && isMe(homeId, request.resource.data.memberId));
        allow update, delete: if isAdmin(homeId);
      }

      // Agenda familiar: cada uno maneja lo suyo; los administradores, todo.
      match /events/{eventId} {
        allow read: if isMember(homeId);
        allow create: if isAdmin(homeId)
          || (isMember(homeId) && isMe(homeId, request.resource.data.createdBy));
        allow update, delete: if isAdmin(homeId)
          || (isMember(homeId) && isMe(homeId, resource.data.createdBy));
      }

      // Partidas del Área de juegos.
      match /games/{gameId} {
        allow read, write: if isMember(homeId);
      }

      match /notices/{noticeId} {
        allow read, create: if isMember(homeId);
        allow delete: if isAdmin(homeId);
      }
    }
  }
}
