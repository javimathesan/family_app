# Fin de línea uniforme (LF) en el repo, sin importar si se trabaja en Windows, Mac o Linux.
* text=auto eol=lf

# Archivos de Windows que necesitan CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca convertir.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
